# Copiar este archivo como .env y completar con los datos del proyecto de Supabase
# (Project Settings → API). La clave "anon" es pública: la seguridad la dan las políticas RLS.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Dirección donde queda publicada la versión web (la usan los QR de los equipos
# y los mails de recuperación de contraseña para los celulares).
VITE_WEB_URL=https://estebanbullano.github.io/mantenimiento-rossi
